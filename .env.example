# URL da API enviada por você para dados ao vivo.
# O endpoint deve responder JSON com um destes formatos de chuva:
# 1) { "observedRainMmPerHour": 12.3 }
# 2) { "rainMmPerHour": 12.3 }
# 3) { "rain": 12.3 }
# 4) { "current": { "rain": 12.3 } }
LIVE_OBSERVATION_API_URL=https://sua-api-ao-vivo.exemplo.com/realtime

# IA Gemini para enriquecimento da busca do cidadão
GEMINI_API_KEY=
